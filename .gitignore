# Keep the directory, but do not version screenshots accidentally
assets/screenshots/*.png
assets/screenshots/*.jpg
assets/screenshots/*.jpeg
!assets/screenshots/.gitkeep
!assets/screenshots/terminal-preview.png

# Local device settings; keep only the shared example
/devices/*
!/devices/example.json

# Selected README gallery
/assets/screenshots/gallery/*
!/assets/screenshots/gallery/desktop.svg
!/assets/screenshots/gallery/layout.svg
!/assets/screenshots/gallery/terminal.svg
!/assets/screenshots/gallery/wallpapers.svg
!/assets/screenshots/gallery/media.svg
!/assets/screenshots/gallery/power.svg

